{
  "name": "ironfit",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "expo start --expo-go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "help": "node ./scripts/help.js",
    "apk_config_install": "npm install -g eas-cli && eas login",
    "apk": "eas build --platform android --profile preview",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "^44.0.6",
    "expo-device": "~8.0.10",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^4.4.3"
  },
  "private": true,
  "devDependencies": {
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^11.0.0",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.5.2",
    "jest": "^25.0.0",
    "jest-expo": "^56.0.0"
  }
}
